  <style type="text/css" data-vite-dev-id="C:/Users/Andrew/projects/stripe-dashboard/frontend/src/App.css">:root {
  color-scheme: light;
}

body {
  margin: 0;
  background: #f6f7f9;
  color: #1a1d23;
  font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
}

.page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

h1 {
  margin: 0;
  font-size: 28px;
  letter-spacing: -0.02em;
}

.sub {
  margin: 6px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin: 32px 0;
}

.card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.card .label {
  font-size: 13px;
  color: #6b7280;
}

.card .value {
  font-size: 24px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  overflow: hidden;
  font-size: 14px;
}

th {
  text-align: left;
  padding: 12px 16px;
  background: #fafafa;
  border-bottom: 1px solid #e5e7eb;
  font-weight: 600;
  color: #4b5563;
}

td {
  padding: 12px 16px;
  border-bottom: 1px solid #f3f4f6;
}

tr:last-child td {
  border-bottom: none;
}

.right {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.pill {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 12px;
  background: #ecfdf5;
  color: #047857;
}

.state {
  padding: 60px;
  text-align: center;
  color: #6b7280;
}

.state.error {
  color: #b91c1c;
}</style></head>
